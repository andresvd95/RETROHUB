<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_s">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/platform_card_height"
        android:background="@drawable/bg_card_surface"
        android:backgroundTint="@color/bg_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m">

        <View
            android:id="@+id/accent"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/space_m"/>

        <TextView
            android:id="@+id/emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:text="🎮"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_m"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@color/text_primary"
            android:textSize="9sp"
            android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
