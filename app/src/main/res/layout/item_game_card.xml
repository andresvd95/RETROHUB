<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingEnd="@dimen/space_m"
    android:paddingTop="@dimen/space_xs"
    android:paddingBottom="@dimen/space_xs">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="@dimen/game_card_size"
        android:layout_height="@dimen/game_card_size"
        android:background="@drawable/bg_card_small"
        android:backgroundTint="@color/bg_card">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="cover"/>

        <TextView
            android:id="@+id/emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🎮"
            android:textSize="36sp"/>

        <TextView
            android:id="@+id/platform_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_chip_dark"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@color/text_primary"
            android:textSize="8sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="@dimen/game_card_size"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/playtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_faint"
        android:textSize="9sp"/>
</LinearLayout>
