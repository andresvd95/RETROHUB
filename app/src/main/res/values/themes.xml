<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.RetroHub" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorPrimaryVariant">@color/brand_red_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/brand_red</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_root</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <!-- To use the Outfit typeface, drop outfit.ttf into res/font/ and uncomment:
             <item name="android:fontFamily">@font/outfit</item> -->
        <item name="bottomNavigationStyle">@style/RetroHub.BottomNav</item>
        <item name="materialAlertDialogTheme">@style/RetroHub.AlertDialog</item>
    </style>

    <style name="RetroHub.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/bg_root</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="RetroHub.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/bg_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/RetroHub.AlertTitle</item>
    </style>

    <style name="RetroHub.AlertTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.SectionLabel">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RetroHub.Chip">
        <item name="android:paddingStart">@dimen/space_s</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_chip</item>
    </style>
</resources>
